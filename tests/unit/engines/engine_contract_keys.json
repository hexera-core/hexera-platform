    "boundary_types",
    true,
    "GROUPS"
   ]
  ],
  "input_contract": {
   "input_kind": "surface",
   "min_thickness_ratio": 0.0,
   "rationale": "snappyHexMesh is a 3D hex/split-hex mesher - 3D ONLY. It has no 2D mode (true 2D belongs to cfMesh's native cartesian2DMesh), and a thin slab is simply a 3D case with symmetry patches. It body-fits a surface STL and wants cleaner geometry than cfMesh. Thin features are resolved by surface refinement level, so no hard thin-feature floor.",
   "require_no_self_intersection": false
  },
  "required_run_files": [
