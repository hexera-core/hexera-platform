# Snapshot v3: the same splits as v2 (dev_v2 150 + clean_v2 40), read FROM THE RUN COMMIT; all four arms; new clean
# (valid + panel). The run commit is the tip resolved at launch time. Waves are the snap_v2 normal waves (same splits);
# the doc and wave ids are labelled v3.
LABEL=v3
# wave ids say what this is: the THIRD wave, on the v2 SPLITS, at its own commit (not a rerun of v2)
WAVE_TAG=v2splits
DEV_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_dev_v2.json
CLEAN_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_clean_v2.json
DEV_WAVE=snap_v2_dev
CLEAN_WAVE=snap_v2_clean
DEV_SHARDS=26
CLEAN_SHARDS=2
TOTAL_USD=49.95
FILE_USD_CAP=1.00
# empty = the run commit's evalspec.SHARED_BUDGET.ops (Lane D: ops never bind, max 45 of 60): nothing is raised or lowered
OPS=
ROUTE=openai:gpt-6-astra
MACHINE=c2d-standard-56
VM_USD_PER_H=2.63
# the search wall is SOFT (D15: checked between expansions; one file overshot by 1406 s; 6 of 30 ran > 40 min under a
# nominal 600 s), so the reaper is sized from v2's MEASURED wave wall, not the plan: see the v3 launch note
MAX_RUN=7h
# per-file costs for the shard plan: v2's measured rows (all four arms, this code's pace)
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1r/prior-v2
IMAGE=us-central1-docker.pkg.dev/hexera-dev/mesh/crsv4-mesh@sha256:3e8c6fae170342bbb53cf63685c2e49a77f0e6ab042e308a1f038a82e05e3592
IMAGE_COMMIT=1d6ed735f7284609a269ca314c15ff6b0e359d4b
