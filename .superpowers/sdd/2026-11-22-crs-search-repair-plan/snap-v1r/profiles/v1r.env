# Snapshot v1r: the 30 dev + 8 clean files of snapshot v1, RELABELLED on the engine's form (partial_reprobe _v1r).
LABEL=v1r
DEV_SPLIT_SPEC=sdd/reprobe-800:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_dev_v1r.json
CLEAN_SPLIT_SPEC=sdd/reprobe-800:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_clean_v1r.json
DEV_WAVE=snap_v1r_dev
CLEAN_WAVE=snap_v1r_clean
DEV_SHARDS=6
CLEAN_SHARDS=1
TOTAL_USD=15
FILE_USD_CAP=0.5
OPS=24
ROUTE=openai:gpt-6-astra
MACHINE=c2d-standard-16
VM_USD_PER_H=0.75
MAX_RUN=6h
# per-file costs for the shard plan: snapshot v1's measured all-arm walls
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1/results
