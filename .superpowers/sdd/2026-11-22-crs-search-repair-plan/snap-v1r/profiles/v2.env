# Snapshot v2: the re-probe's PROVISIONAL dev_v2 / clean_v2 splits (reprobe-800), snap_v2 waves (on sdd/reprobe-800).
LABEL=v2
DEV_SPLIT_SPEC=sdd/reprobe-800:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_dev_v2.json
CLEAN_SPLIT_SPEC=sdd/reprobe-800:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_clean_v2.json
DEV_WAVE=snap_v2_dev
CLEAN_WAVE=snap_v2_clean
# 26 + 2 shards on 56 vCPU: two vCPUs (one physical core) per shard, so wall clocks are not inflated by contention
DEV_SHARDS=26
CLEAN_SHARDS=2
TOTAL_USD=50
FILE_USD_CAP=0.5
OPS=24
ROUTE=openai:gpt-6-astra
MACHINE=c2d-standard-56
VM_USD_PER_H=2.63
MAX_RUN=5h
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1/results
