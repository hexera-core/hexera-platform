# PHASE PROBE (coordinator, 2026-11-24): the 8 fast-loop dev files that hit the 1200 s file wall, search_det only, file
# wall 2400 s so every phase finishes, search at the arm default wall (600 s). Unit logs carry PHASE lines (arms._Phases).
LABEL=phase
DEV_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/fast_dev_v1/PHASE_PROBE_v1.json
CLEAN_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/fast_dev_v1/FAST_clean_v1.json
DEV_WAVE=fast_v1_dev
CLEAN_WAVE=fast_v1_clean
# one group per (split, search arm); every (file, arm) is its own shard where the quota allows
ARM_GROUPS="dev_det:search_det:dev"
# 20 min per (file, arm), the search stops itself at 900 s (coordinator, 2026-11-24: at 300 s, 25 of 30 dev pairs were file_timeout)
FILE_TIMEOUT_S=2400
SEARCH_WALL_S=
REGIONS="us-west2:56:us-west2-a,us-west2-b,us-west2-c"
TARGET_MIN=45
TOTAL_USD=1.00
FILE_USD_CAP=1.00
OPS=
ROUTE=openai:gpt-6-astra
MAX_RUN=3h
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1r/runs/v2-202611240348/out
IMAGE=us-central1-docker.pkg.dev/hexera-dev/mesh/crsv4-mesh@sha256:3e8c6fae170342bbb53cf63685c2e49a77f0e6ab042e308a1f038a82e05e3592
IMAGE_COMMIT=1d6ed735f7284609a269ca314c15ff6b0e359d4b
# the measured density (packing pilot): ~0.67 containers per core
VCPU_PER_SHARD=1.5
