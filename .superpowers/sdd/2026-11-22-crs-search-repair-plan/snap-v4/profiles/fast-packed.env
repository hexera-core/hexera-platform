# THE FAST LOOP, PACKING PILOT variant (same frozen FAST-DEV v1 list, same walls): see the end of this file.
# read from the run commit), SEARCH ARMS ONLY, 5 min per (file, arm), target ~15 min end to end, run after every
# merge batch (at most hourly) with the delta against the previous run.
LABEL=fastpk
DEV_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/fast_dev_v1/FAST_dev_v1.json
CLEAN_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/fast_dev_v1/FAST_clean_v1.json
DEV_WAVE=fast_v1_dev
CLEAN_WAVE=fast_v1_clean
# one group per (split, search arm); every (file, arm) is its own shard where the quota allows
ARM_GROUPS="dev_ai:search_ai:dev dev_det:search_det:dev clean_ai:search_ai:clean clean_det:search_det:clean"
# 5 min per (file, arm); the search stops itself at 240 s so it ends inside the file wall instead of being killed
FILE_TIMEOUT_S=300
SEARCH_WALL_S=240
REGIONS="us-east1:32:us-east1-b,us-east1-c,us-east1-d"
TARGET_MIN=1
TOTAL_USD=20.00
FILE_USD_CAP=1.00
OPS=
ROUTE=openai:gpt-6-astra
MAX_RUN=2h
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1r/runs/v2-202611240348/out
IMAGE=us-central1-docker.pkg.dev/hexera-dev/mesh/crsv4-mesh@sha256:3e8c6fae170342bbb53cf63685c2e49a77f0e6ab042e308a1f038a82e05e3592
IMAGE_COMMIT=1d6ed735f7284609a269ca314c15ff6b0e359d4b
# PACKING PILOT (owner directive): all 40 (file, arm) units on ONE c2d-standard-32 = 1.25 containers per core and
# ~3.2 GB RAM each, HARSHER than 50 on a c2d-56 (0.89/core, 4.5 GB). vm_run samples load/core, memory and containers
# every 15 s and records kernel OOM kills and exit-137 units.
VCPU_PER_SHARD=0.8
