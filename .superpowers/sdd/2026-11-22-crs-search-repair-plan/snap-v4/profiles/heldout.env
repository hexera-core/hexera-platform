# THE SEALED HELD-OUT RUN (lane C14). Prepared only; it is launched ONCE, by a human, on the freeze:
#
#   git tag -a crs-v4-freeze-<YYYYMMDD> <commit> -m "..."      # the freeze (launch.sh refuses without it)
#   bash snap-v4/launch.sh crs-v4-freeze-<YYYYMMDD> heldout --dry-run   # checks everything, touches no held-out byte
#   bash snap-v4/launch.sh crs-v4-freeze-<YYYYMMDD> heldout             # the one run
#
# What is different from v4.env, and why:
#  * HELDOUT=1: launch.sh runs freeze_guard.py FIRST (a tag matching FREEZE_PATTERN must name the run commit, and the
#    commit must contain REQUIRE_COMMITS), lists inputs by NAME (no wildcard over the inputs prefix; held-out objects
#    are not even listed on a dry run), checks the once-only slot model-ledger/slot/held_out/1 in the dry run and
#    CLAIMS it (bucket create-if-absent) before any VM on a real run. The report gets --frozen-commit and verifies the
#    slot against the bucket's own marker.
#  * ONE held-out group, all four arms: the held_out type has ONE slot and its report needs ONE wave_id across every
#    shard, so the per-arm groups v4 uses for dev would be refused (prep.py says so). 25 files fit in one group: at
#    most 25 shards, under the search_ai throttle ceiling of 37.
#  * The clean control rides along as its own NORMAL wave (no slot, the $50 normal cap): the frozen commit's
#    regression check on the 40 clean files, in the same run, at no cost to the held-out slot.
#  * The dev split is listed (CALIB_SPLIT_SPEC) only to calibrate the shard-size model on the prior wave's measured
#    walls; no dev file is staged or run.
LABEL=heldout
HELDOUT=1
FREEZE_PATTERN=crs-v4-freeze-*
# must be IN the frozen commit (freeze_guard refuses otherwise):
#   39f52d73 B18, the anytime rule (a wall-stopped search delivers and verdicts its best state)
#   2bd03537 C12a, gaming flags on VALID-NOT-CLEAN delivered outputs (the 0.07%-volume delivery is reported)
#   03764a28 C13, the report binds model spend per ORIGINAL group shard (v4's merged report falsely refused)
REQUIRE_COMMITS="39f52d73857b3fe99062fa390d6e6c7be3ce9f1b 2bd035376a41402a4add2e7466fe9cbc28538b66 03764a28581ecb660c70853105c1ebbd5b4e8eda"
# the sealed manifest's CONTENT, pinned: launch.sh refuses if the frozen commit's copy differs (25 files)
HELDOUT_SPLIT_SHA256=2ba86ba2a38618f0cfb3f22f1a318dca872aa8b6fafad434fae025b3b1d46a56
# the sealed manifest, read FROM THE FROZEN COMMIT (COMMIT: = the run commit), never from a branch tip
DEV_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/provisional_sample_task43/PROVISIONAL_heldout.json
DEV_SPLIT_NAME=heldout
DEV_WAVE=heldout_v4
CLEAN_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_clean_v2.json
CLEAN_WAVE=snap_v2_clean
CALIB_SPLIT_SPEC=COMMIT:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_dev_v2.json
ARM_GROUPS="heldout:input_only,staged,search_det,search_ai:dev clean:input_only,staged,search_det,search_ai:clean"
# 25 held-out + 40 clean files need ~13 shard slots (~20 vCPU at 1.5 per shard). Two c2d-16 (21 slots) fit the LIVE
# quota the C14 dry run read (us-central1 CPUS free 36, us-east1 C2D_CPUS free 20). Quota moves with other lanes' VMs:
# at the freeze, override without editing this file, e.g.  REGIONS="us-east1:32:us-east1-b" bash launch.sh ...
# prep refuses (naming a target that fits) if the slots do not fit; the quota step refuses if a region is short.
REGIONS="us-east1:16:us-east1-b,us-east1-c,us-east1-d us-central1:16:us-central1-b,us-central1-a,us-central1-c"
TARGET_MIN=60
# the launcher's ceiling over BOTH waves' model shards: the held_out cap ($250, model_ledger.WAVE_CAPS_USD) plus the
# clean control's normal cap ($50). Each wave's own ledger still binds at its type's cap / n_shards per shard.
TOTAL_USD=300
FILE_USD_CAP=1.00
# A FRESH verdict cache for this run only (lane C13, after 1a2eb6d5 made the cache SHARED across runs by default).
# The shared cache would keep the held-out files' verdicts in a store every later dev run reads: no tuning, but a
# persistent derived trace of the sealed set. Nothing in the shared cache can help here anyway (no held-out file has
# ever been judged), so fresh costs nothing and keeps the held-out evidence in this run's own prefix.
VERDICT_CACHE=fresh
# EMPTY: the frozen commit's own Budget.ops
OPS=
ROUTE=openai:gpt-6-astra
MAX_RUN=3h
# the owner's measured packing density for this run
VCPU_PER_SHARD=1.5
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1r/runs/v2-202611240348/out
# REPLACE AT FREEZE if the frozen commit needs a newer mesh image: the label is verified against IMAGE_COMMIT
IMAGE=us-central1-docker.pkg.dev/hexera-dev/mesh/crsv4-mesh@sha256:3e8c6fae170342bbb53cf63685c2e49a77f0e6ab042e308a1f038a82e05e3592
IMAGE_COMMIT=1d6ed735f7284609a269ca314c15ff6b0e359d4b
