# Snapshot v4: the per-arm, multi-VM, two-region shape lane B14 measured and B17 implemented.
LABEL=v4pilot
DEV_SPLIT_SPEC=sdd/reprobe-800:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_dev_v2.json
CLEAN_SPLIT_SPEC=sdd/reprobe-800:devtools/validation/corpora/v4/provisional_v2/PROVISIONAL_clean_v2.json
DEV_WAVE=snap_v2_dev
CLEAN_WAVE=snap_v2_clean
# <region>:<vCPU the LIVE quota allows>:<zones, tried in order>. 88 in us-central1 leaves the other teams ~20 vCPU
# of the region-wide CPUS 200 (B14: ~92 is theirs); us-east1 is empty, so 96 there needs no quota raise either.
REGIONS="us-central1:8:us-central1-b,us-central1-a us-east1:8:us-east1-b,us-east1-c"
# every arm group is sized to finish inside this many minutes; search_ai may still overrun it at its 37-shard
# ceiling, and prep REFUSES (with the feasible target) rather than packing more work into fewer shards
TARGET_MIN=30
TOTAL_USD=4.00
FILE_USD_CAP=0.25
# EMPTY on purpose: the ruling is to use the commit's own Budget.ops (60), which v3c is running. launch.sh reads
# the commit's default, passes no --ops, and refuses an OPS above it.
OPS=
ROUTE=openai:gpt-6-astra
MAX_RUN=1h
# per-arm costs for the shard plans: v2's COMMITTED measured walls (v1's are obsolete - C4 turned search_det's
# median from 28 s into 921 s, so v1 cannot size a v4 shard). prep.py REFUSES a missing or empty prior rather than
# falling back to an uncalibrated size model, which is how a 5-slot "40 minute" plan was printed for a job of tens
# of hours. Deadline-unmeasured and reason-lost exclusions are skipped, not charged at the 1800 s wall.
PRIOR_ROWS=.superpowers/sdd/2026-11-22-crs-search-repair-plan/snap-v1r/runs/v2-202611240348/out
# labelled image (Lane A): mesh build of 1d6ed735; the label is verified against IMAGE_COMMIT before any VM
IMAGE=us-central1-docker.pkg.dev/hexera-dev/mesh/crsv4-mesh@sha256:3e8c6fae170342bbb53cf63685c2e49a77f0e6ab042e308a1f038a82e05e3592
IMAGE_COMMIT=1d6ed735f7284609a269ca314c15ff6b0e359d4b
