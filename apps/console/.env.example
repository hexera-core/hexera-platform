# Google OAuth from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public browser origin for WebSocket streams. Use the same API origin users can reach.
NEXT_PUBLIC_HEXERA_API_BASE_URL=http://localhost:8000

# Private server-side API origin used by the authenticated /api/v1 proxy.
HEXERA_API_BASE_URL=http://localhost:8000

# Optional when the FastAPI deployment requires these headers.
MESH_API_KEY=
USER_TOKEN_SECRET=
