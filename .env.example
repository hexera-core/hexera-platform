# Responsibility: List every supported setting with its default, as the template .env is created from.
# Boundaries: generated from the settings inventory: a name absent from it is not a setting.

# Hexera Platform example configuration
#
# THIS FILE IS THE TEMPLATE, NOT YOUR CONFIGURATION. `make setup` copies it to .env when you have
# no .env yet, and leaves an existing one untouched. Edit .env; never edit this file by hand.
#
# Then set the two keys marked REQUIRED. .env is gitignored and is the only file the application
# reads.
#
# A shell variable beats .env, and .env beats the default shown here.
#
# WHAT THIS FILE CONTAINS: every setting a developer or operator is expected to turn. It is NOT
# the whole catalogue. src/meshpipeline/settings/inventory.py also declares advanced controls
# deliberately kept out of this template, and variables supplied by the platform or a library
# rather than by editing .env: each one carrying the reason it is not here. That module is the
# complete list; this file is the part meant for you. Refresh after a settings change:
#
#     .venv/bin/python -m meshpipeline.settings.inventory > .env.example


# LLM: DeepSeek (intake / search summarizer)
# A real key is the one thing you must set for a live job.
# REQUIRED - real key from platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# LLM: DeepInfra (builder + reviewer, OpenAI-compatible)
# REQUIRED - real key from deepinfra.com
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
REVIEWER_MODEL=Qwen/Qwen3-VL-235B-A22B-Thinking
# DeepInfra caps output at 16384 tokens per response for these models
BUILDER_MAX_TOKENS=16384
REVIEWER_MAX_TOKENS=16384
# reviewer sampling; the value the shipped stack has always run with
REVIEWER_TEMPERATURE=0.7
REVIEWER_TOP_P=0.8
REVIEWER_PRESENCE_PENALTY=1.5

# Resilience (circuit breaker)
# A dependency that fails repeatedly trips its breaker and the job fails as a system issue;
# there are no fallback models that silently degrade mesh quality.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
CIRCUIT_HALF_OPEN_MAX=1
# a job that keeps crashing the worker is dead-lettered after this many deliveries
CELERY_MAX_REDELIVERIES=3

# Remote mesh execution
# The local stack is the control plane; every mesh runs off-box on the Cloud Run mesh job.
# dev-up and dev-doctor require the values below and refuse to start without them.
# REQUIRED - the project hosting the Cloud Run mesh job
GCP_PROJECT_ID=
GCP_REGION=us-central1
# REQUIRED - the Cloud Run mesh job to dispatch to
CLOUDRUN_JOB=
# REQUIRED - the GCS bucket workspaces are exchanged through
GCP_MESH_BUCKET=
# REQUIRED - THE canonical location, resolved from the repository root. Obtain your own file
#   with 'gcloud auth application-default login' and move it there; Hexera never creates it. A
#   path, never a credential: never paste the JSON here, and never use someone else's file
GOOGLE_ADC_FILE=./secrets/gcp/application_default_credentials.json
OPENFOAM_BASHRC=/usr/lib/openfoam/openfoam2412/etc/bashrc
OPENFOAM_COMMAND_TIMEOUT=1500
# must be >= 2 * OPENFOAM_COMMAND_TIMEOUT (validated at startup)
BUILDER_LOOP_TIMEOUT=3600

# Agent round budgets
# How many PROVIDER ROUNDS one agent invocation may take. Not tool-call budgets: an agent may
# issue several tool calls inside one round. The defaults are the shipped values; leave them
# unset unless you have measured a reason.
# rounds per intake conversation turn; must be a positive integer
INTAKE_MAX_ROUNDS=20
# rounds for a first build attempt
BUILDER_MAX_ROUNDS=60
# rounds for a rebuild attempt: shorter, because a retry starts from a reviewed failure
BUILDER_RETRY_MAX_ROUNDS=45
# rounds for one review invocation
REVIEWER_MAX_ROUNDS=60

# PostgreSQL
# Addresses on this machine: .env is edited on the host. The stack sets the container names
# its services answer on.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meshpipeline
POSTGRES_USER=meshpipeline
# fine for local dev; set a strong value for production: the code falls back to empty so an
#   unset password fails closed
POSTGRES_PASSWORD=localdev
# a managed-Postgres connection string (e.g. Neon). When set it is THE database and the
#   POSTGRES_* parts above are unused
DATABASE_URL=

# Redis (broker + pub/sub)
# set in production and use a credentialed REDIS_URL
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
# the address a BROWSER reaches the store on. Signed download URLs are signed FOR their host,
#   so this must be the address the user's browser uses, not the one the container dials.
#   Blank = same as MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
# signed into every URL as part of the SigV4 credential scope, and passed explicitly so the
#   client never makes a GetBucketLocation call to discover it. MinIO's default; change only
#   for a store that reports a different region
MINIO_REGION=us-east-1
# reach the object store over TLS. False for the local compose stack, which serves plain HTTP
#   on the same host. A hosted S3-compatible endpoint (Google Cloud Storage through its
#   S3-interoperability API, for one) serves TLS only and refuses a plain-HTTP request
MINIO_SECURE=false
# MinIO's own local default
MINIO_SECRET_KEY=minioadmin
# bucket names must be lowercase; an uppercase value is rejected and the stack never becomes
#   ready
MINIO_BUCKET=mesh-artifacts
MINIO_SIGNED_URL_TTL=900

# Web search sub-agent (SearXNG retrieval + DeepSeek distillation)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_BASE_URL=http://localhost:8080

# Auth / environment
# ENV=production enforces a non-empty MESH_API_KEY, non-wildcard CORS_ORIGINS, and a set
# POSTGRES_PASSWORD at startup. USER_TOKEN_SECRET enables signed X-User-Id so identity is not
# self-asserted.
ENV=dev
MESH_API_KEY=
USER_TOKEN_SECRET=
CORS_ORIGINS=*
# the Identity Platform project whose ID tokens the console signs in with
FIREBASE_PROJECT_ID=

# Product modes
# Save redacted run data for training and corpus export.
DATA_COLLECTION_ENABLED=true
# Control technical details shown through the UI: safe or raw.
PUBLIC_TRACE_MODE=raw
# Required when PUBLIC_TRACE_MODE=raw to prevent accidental disclosure.
ALLOW_PUBLIC_RAW_TRACE=true

# Optional: Langfuse tracing (leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Quotas
MAX_JOBS_PER_OWNER=5
MAX_CONCURRENT_JOBS=20
# credits a newly provisioned organisation is granted once; 0 disables it
SIGNUP_GRANT_CREDITS=100
# whether an unknown Identity Platform account may provision itself an organisation on first
#   sign-in
CONSOLE_SIGNUP_ENABLED=true
# how long a retryable artifact-reconciliation failure waits before the sweep may claim it
#   again
RECONCILE_RETRY_DELAY_SECONDS=300
# read by docker-compose.yml when it starts the worker, not by the application
CELERY_WORKER_CONCURRENCY=2

# Postgres connection pool
# Per process. The API container and the worker each open their own pool against the local
# database.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Logging
# json emits one JSON object per line; blank is human-readable
LOG_FORMAT=
LOG_LEVEL=INFO

# Distributed tracing (OpenTelemetry): off by default
# OTEL_TRACES_ENABLED=true plus an endpoint ties an API request, worker job, and each LLM call
# into one trace. OTEL_TRACES_EXPORTER=console prints spans to stdout for a quick smoke.
# set true to export traces
OTEL_TRACES_ENABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mesh-api

# Filesystem layout
# Relative to the process working directory, never to the installed package: an installed
# distribution must not write into site-packages. The images WORKDIR /srv, so these resolve to
# /srv/... there and to your checkout on a host.
# root of the writable data layout
DATA_ROOT=./data
# per-job upload staging - defaults to <DATA_ROOT>/jobs
JOBS_DIR=
# written only while collection is on; not swept: remove samples you no longer want - defaults
#   to <DATA_ROOT>/corpus
CORPUS_DIR=
# engine workspaces for running jobs
WORKSPACE_BASE=./workspaces
# the browser client served at /ui; ./ui is your checkout on a host and /srv/ui in the image,
#   because both resolve it from the working directory
STATIC_DIR=./ui

# Request limits
# per identity (X-User-Id, else client IP); 0 disables. Job quotas are separate
RATE_LIMIT_PER_MINUTE=240
# close a live socket on our terms before the platform's 60-minute cap; the browser reconnects
#   with its cursor
WS_MAX_SESSION_SECONDS=3000
# how long a job's replayable event log outlives its sockets
EVENT_LOG_TTL_SECONDS=86400

# Retention and job lifetime
FAILED_JOB_RETENTION_HOURS=24
UPLOAD_RETENTION_DAYS=30
# a job with no progress for this long is reaped and failed truthfully
STALLED_JOB_TIMEOUT_HOURS=4
# one absolute wall-clock ceiling for an ENTIRE job across every attempt, retry and restart
PIPELINE_TOTAL_TIMEOUT_SECONDS=21600

# Worker lease and fencing
# A claim is valid for the lease without a heartbeat; the owner heartbeats well inside it, and
# a takeover is only allowed once the lease has EXPIRED.
WORKER_LEASE_SECONDS=900
# must be well under WORKER_LEASE_SECONDS (validated at import)
WORKER_HEARTBEAT_SECONDS=60
# forced on outside development; leave blank
REQUIRE_DURABLE_CHECKPOINTER=
# which execution backend the run is attributed to
PIPELINE_BACKEND=celery

# Safety switches
# On by default. Each one is a gate that refuses bad geometry or unsafe generated work; turn
# one off only with a measured reason.
SOLVABILITY_GATE_ENABLED=true
DOMAIN_EXTENT_GATE_ENABLED=true
MESH_SCRIPT_SCAN_ENABLED=true
# refuse to run generated Python outside the seccomp/Landlock jail
RUN_PYTHON_REQUIRE_SANDBOX=true
# compute-feasibility cap on mesh size: the only cell-count gate
CELL_HARD_LIMIT=8000000
# areal prism-layer coverage floor for caveated delivery of external-aero snappy meshes; below
#   it a layers-only review FAIL stays a failure
LAYER_CAVEAT_FLOOR_PCT_EXTERNAL=40
# per-wall-patch thickness floor for caveated delivery: one effectively bare wall patch keeps
#   the failure a failure
LAYER_CAVEAT_PATCH_MIN_THICKNESS_PCT=10

# Workspace archive limits
# Bounds on the workspace archive a remote mesh returns: a decompression bomb, a traversal
# entry or a runaway member is refused before anything is written.
# compressed archive ceiling
WORKSPACE_ARCHIVE_MAX_BYTES=536870912
WORKSPACE_ARCHIVE_MAX_ENTRIES=20000
# cumulative expanded size
WORKSPACE_ARCHIVE_MAX_TOTAL_BYTES=4294967296
# any single regular file
WORKSPACE_ARCHIVE_MAX_FILE_BYTES=1073741824
WORKSPACE_ARCHIVE_MAX_DEPTH=40
WORKSPACE_ARCHIVE_MAX_PATH_LEN=1024
# uncompressed/compressed ceiling
WORKSPACE_ARCHIVE_MAX_RATIO=200.0

# Viewer and dispute
VIEWER_GRID_PX=2.5
VIEWER_FINE_FILL=8
VIEWER_FRAME_FRAC=0.85
VIEWER_FLAG_SPAN_FACTOR=2.5
DISPUTE_MAX_FLAGS=20

# Provider timeouts and retries
DEEPINFRA_CALL_TIMEOUT=1800
DEEPINFRA_CONNECT_TIMEOUT=15
DEEPINFRA_READ_TIMEOUT=60
DEEPINFRA_WRITE_TIMEOUT=30
# mesh retries after a quality judgement; total build attempts = this + 2 (3 total)
MAX_BUILDER_RETRIES=1
MAX_SNAPPY_ATTEMPTS=3
# replays of a builder attempt killed by a TRANSIENT system failure; 0 disables
BUILDER_INFRA_RETRY_MAX=2
# wait before an infra replay - long enough to outlive a provider brownout
BUILDER_INFRA_RETRY_BACKOFF_S=90

# Web search sizing
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=20
# required only when WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Mesh toolchain
# vmtk runs as an isolated subprocess: its conda VTK cannot coexist with the app's
VMTK_BIN=vmtk

# Error reporting
# leave blank to disable
SENTRY_DSN=

# Inference overrides
# Two structured settings, each one declared name. They replace the
# MODEL_PRICE_<PROVIDER>_<MODEL> and MODEL_BUDGET_<DOMAIN> namespaces, where the variable NAME
# was built from provider and model data: so the supported surface was unlistable and a typo
# was indistinguishable from an unsupported setting.
# per-1M-token prices for models whose published price the shipped table does not carry.
#   Schema: 'provider:model=in,out,cached' separated by ';'. The provider must be one this
#   product supports; prices must be finite and non-negative. Example:
#   'deepinfra:Qwen/Qwen3-VL-235B-A22B-Thinking=0.20,0.88,0.11'
MODEL_PRICE_OVERRIDES=
# concurrency budget per quota domain, overriding the routes' own. Schema:
#   'provider:account:model=N' separated by ';'. The provider must be one this product
#   supports and N a positive whole number.
MODEL_DOMAIN_BUDGETS=

# Model route: intake
# The intake role's provider, model and reliability budget. Every name below is supported
# configuration; leave them unset to run the shipped route.
# which supported provider serves this role
INTAKE_PROVIDER=deepseek
# the model identifier sent to that provider
INTAKE_MODEL=deepseek-v4-pro
# quota account; roles sharing one provider+account+model share a concurrency domain
INTAKE_ACCOUNT=default
# optional second provider; set together with the standby model or startup refuses
INTAKE_STANDBY_PROVIDER=
# optional second model; set together with the standby provider or startup refuses
INTAKE_STANDBY_MODEL=
# quota account for the standby; read only when a standby is configured
INTAKE_STANDBY_ACCOUNT=default
# per-attempt ceiling in seconds
INTAKE_TIMEOUT=120.0
# attempts before the role fails
INTAKE_MAX_ATTEMPTS=5
# first retry delay in seconds
INTAKE_BACKOFF_BASE=5.0
# retry delay ceiling in seconds
INTAKE_BACKOFF_MAX=60.0
# in-flight calls allowed for this role's quota domain
INTAKE_CONCURRENCY_BUDGET=16
# seconds a call may wait for admission before the standby is considered
INTAKE_QUEUE_DEADLINE=15.0

# Model route: builder
# The builder role's provider, model and reliability budget. Every name below is supported
# configuration; leave them unset to run the shipped route.
# which supported provider serves this role
BUILDER_PROVIDER=deepinfra
# the model identifier sent to that provider
BUILDER_MODEL=zai-org/GLM-5.2
# quota account; roles sharing one provider+account+model share a concurrency domain
BUILDER_ACCOUNT=default
# optional second provider; set together with the standby model or startup refuses
BUILDER_STANDBY_PROVIDER=
# optional second model; set together with the standby provider or startup refuses
BUILDER_STANDBY_MODEL=
# quota account for the standby; read only when a standby is configured
BUILDER_STANDBY_ACCOUNT=default
# per-attempt ceiling in seconds
BUILDER_TIMEOUT=1800.0
# attempts before the role fails
BUILDER_MAX_ATTEMPTS=3
# first retry delay in seconds
BUILDER_BACKOFF_BASE=15.0
# retry delay ceiling in seconds
BUILDER_BACKOFF_MAX=120.0
# in-flight calls allowed for this role's quota domain
BUILDER_CONCURRENCY_BUDGET=8
# seconds a call may wait for admission before the standby is considered
BUILDER_QUEUE_DEADLINE=30.0

# Model route: visual_reviewer
# The visual_reviewer role's provider, model and reliability budget. Every name below is
# supported configuration; leave them unset to run the shipped route.
# which supported provider serves this role
VISUAL_REVIEWER_PROVIDER=deepinfra
# the model identifier sent to that provider
VISUAL_REVIEWER_MODEL=Qwen/Qwen3-VL-235B-A22B-Thinking
# quota account; roles sharing one provider+account+model share a concurrency domain
VISUAL_REVIEWER_ACCOUNT=default
# optional second provider; set together with the standby model or startup refuses
VISUAL_REVIEWER_STANDBY_PROVIDER=
# optional second model; set together with the standby provider or startup refuses
VISUAL_REVIEWER_STANDBY_MODEL=
# quota account for the standby; read only when a standby is configured
VISUAL_REVIEWER_STANDBY_ACCOUNT=default
# per-attempt ceiling in seconds
VISUAL_REVIEWER_TIMEOUT=1800.0
# attempts before the role fails
VISUAL_REVIEWER_MAX_ATTEMPTS=3
# first retry delay in seconds
VISUAL_REVIEWER_BACKOFF_BASE=5.0
# retry delay ceiling in seconds
VISUAL_REVIEWER_BACKOFF_MAX=60.0
# in-flight calls allowed for this role's quota domain
VISUAL_REVIEWER_CONCURRENCY_BUDGET=8
# seconds a call may wait for admission before the standby is considered
VISUAL_REVIEWER_QUEUE_DEADLINE=30.0

# Model route: summarizer
# The summarizer role's provider, model and reliability budget. Every name below is supported
# configuration; leave them unset to run the shipped route.
# which supported provider serves this role
SEARCH_SUMMARIZER_PROVIDER=deepseek
# the model identifier sent to that provider
SEARCH_SUMMARIZER_MODEL=deepseek-v4-flash
# quota account; roles sharing one provider+account+model share a concurrency domain
SEARCH_SUMMARIZER_ACCOUNT=default
# optional second provider; set together with the standby model or startup refuses
SEARCH_SUMMARIZER_STANDBY_PROVIDER=
# optional second model; set together with the standby provider or startup refuses
SEARCH_SUMMARIZER_STANDBY_MODEL=
# quota account for the standby; read only when a standby is configured
SEARCH_SUMMARIZER_STANDBY_ACCOUNT=default
# per-attempt ceiling in seconds
SEARCH_SUMMARIZER_TIMEOUT=60.0
# attempts before the role fails
SEARCH_SUMMARIZER_MAX_ATTEMPTS=2
# first retry delay in seconds
SEARCH_SUMMARIZER_BACKOFF_BASE=2.0
# retry delay ceiling in seconds
SEARCH_SUMMARIZER_BACKOFF_MAX=15.0
# in-flight calls allowed for this role's quota domain
SEARCH_SUMMARIZER_CONCURRENCY_BUDGET=8
# seconds a call may wait for admission before the standby is considered
SEARCH_SUMMARIZER_QUEUE_DEADLINE=10.0

# Model route: planner
# The planner role's provider, model and reliability budget. Every name below is supported
# configuration; leave them unset to run the shipped route.
# which supported provider serves this role
PLANNER_PROVIDER=deepinfra
# the model identifier sent to that provider
PLANNER_MODEL=zai-org/GLM-5.2
# quota account; roles sharing one provider+account+model share a concurrency domain
PLANNER_ACCOUNT=default
# optional second provider; set together with the standby model or startup refuses
PLANNER_STANDBY_PROVIDER=
# optional second model; set together with the standby provider or startup refuses
PLANNER_STANDBY_MODEL=
# quota account for the standby; read only when a standby is configured
PLANNER_STANDBY_ACCOUNT=default
# per-attempt ceiling in seconds
PLANNER_TIMEOUT=1800.0
# attempts before the role fails
PLANNER_MAX_ATTEMPTS=3
# first retry delay in seconds
PLANNER_BACKOFF_BASE=15.0
# retry delay ceiling in seconds
PLANNER_BACKOFF_MAX=120.0
# in-flight calls allowed for this role's quota domain
PLANNER_CONCURRENCY_BUDGET=4
# seconds a call may wait for admission before the standby is considered
PLANNER_QUEUE_DEADLINE=30.0
