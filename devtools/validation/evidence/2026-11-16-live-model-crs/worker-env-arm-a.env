# ARM A worker posture (appended to gs://dev-crs-transfer-224734058693/worker.env; rest of that object is .env.example)
CAD_REPAIR_ENABLED=true
CAD_REPAIR_AUTONOMOUS=true
CAD_REPAIR_FILL_PLANAR_HOLES=true
CAD_REPAIR_FILL_NONPLANAR_HOLES=true
CAD_REPAIR_FIX_SMALL_FACES=true
CAD_REPAIR_SPLIT_CLOSED_FACES=true
CAD_REPAIR_FRAGMENT_BODIES=true
CAD_REPAIR_REBUILD_FACE=true
CAD_REPAIR_REGION_LOOP=live
CAD_REPAIR_MESH_PROBE=live
CAD_REPAIR_REGION_ATTEMPTS=6
CAD_REPAIR_TIMEOUT_S=300
CAD_REPAIR_MAX_OPS=200
CAD_REPAIR_STALL_LIMIT=50
CAD_REPAIR_LLM_AUTHOR=off
CAD_REPAIR_PACKAGE_REVIEW=off
# deployment wiring (template carries no database-url)
POSTGRES_HOST=10.66.0.3
POSTGRES_DB=meshpipeline_crs
GEOMETRY_CHECK_ENABLED=true
